# Required for a new database when listening beyond localhost.
# Use a unique printable value between 24 and 256 bytes.
ADMIN_TOKEN=
# Seals channel API keys and token copies at rest. Recommended under Docker:
# left blank, the key file is made inside the data volume, beside the database.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=
# optional:
# APP__SERVER__PORT=3100
# DATABASE_URL=sqlite:wildtoken.db?mode=rwc
# APP__DATABASE__MAX_CONNECTIONS=3
# APP__DATABASE__SQLITE_CACHE_SIZE_KIB=2048
# APP__DATABASE__SQLITE_STATEMENT_CACHE_CAPACITY=32
# APP__DATABASE__SQLITE_MMAP_SIZE_BYTES=0
# APP__DATABASE__IDLE_TIMEOUT_SECONDS=60
# APP__LOGGING__LOG_QUEUE_CAPACITY=512
# Daily backups: host directory, local time, how many to keep.
# BACKUP_DIR=./.backup
# APP__BACKUP__AT=05:00
# APP__BACKUP__KEEP=10
# WILDTOKEN_LOG=info
